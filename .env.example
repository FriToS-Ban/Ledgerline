GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=google/gemini-3.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INNGEST_DEV=1

# Email intake (optional): poll a mailbox for invoice attachments
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Shared secret for POST /api/intake/email (header x-intake-secret or ?secret=)
INTAKE_SECRET=
# Worker: poll interval in ms; set DISABLE_WORKER=1 to turn the background loop off
WORKER_INTERVAL_MS=15000
DISABLE_WORKER=0

# Sign-in (roles: clerk / approver / admin). AUTH_SECRET is REQUIRED in production.
AUTH_SECRET=
AUTH_DISABLED=0
DEMO_USERS=0
DEMO_PASSWORD=ledgerline

# Hosted database (optional). Leave empty to use the local SQLite file in data/app.db.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ERP connector (optional): GET this URL for { vendors, purchaseOrders, poLines }
ERP_URL=
ERP_TOKEN=
ERP_SYNC_MINUTES=15

# Dashboard assumption: minutes an AP clerk spends per invoice by hand
MANUAL_MINUTES_PER_INVOICE=6

# Which LLM writes the memo: nvidia | google | anthropic | openai (blank = first key found)
LLM_PROVIDER=
# Seconds-scale cap so a slow model can never stall the queue
LLM_TIMEOUT_MS=12000
