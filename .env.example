# ===== LOCAL DEV QUICK START (copy this file to .env, then also set these) =====
# INNGEST_DEV=1          # lets the background worker reach /api/inngest in dev
# DEMO_USERS=1           # demo logins (admin@ledgerline.demo / ledgerline); put it in .env.local
# AUTH_SECRET=<run: openssl rand -hex 32>
# Add ONE AI key below (Google / NVIDIA / OpenAI / Anthropic) and set LLM_PROVIDER to match.
# Without a key, digital PDFs are still parsed locally and scanned/image PDFs are OCR'd with Tesseract
# (lower accuracy; the first OCR downloads the ~10 MB English model, so it needs internet once).
# Google/OpenAI/Anthropic keys also read scanned PDFs directly; NVIDIA is text-only. Never commit keys.
# Then: docker compose --profile dev up -d db s3 ; npm run db:migrate ; DEMO_USERS=1 npm run db:seed ; npm run dev
# Restart `npm run dev` after any .env change.
# ================================================================================
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
# Tried first; on a retired/unknown id the app falls back to current Gemini models, then other providers.
GOOGLE_MODEL=google/gemini-3.8-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Inngest. Production REQUIRES INNGEST_SIGNING_KEY (from the Inngest dashboard) so /api/inngest verifies signatures.
# In dev the endpoint refuses unsigned POST/PUT unless INNGEST_DEV=1 (set it only when running `npm run dev:inngest`).
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# INNGEST_DEV=1

# Email intake (optional): poll a mailbox for invoice attachments
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Shared secret (>= 24 chars) for POST /api/intake/email, sent as header x-intake-secret. REQUIRED: the webhook is
# disabled (503) while it is empty. Set INTAKE_QUERY_SECRET=1 to also accept ?secret= (leaks into logs;
# only for providers that cannot send headers).
INTAKE_SECRET=
INTAKE_QUERY_SECRET=0
# Serverless (Vercel): .github/workflows/cron.yml calls GET /api/cron/tick every 10 minutes with a GitHub OIDC
# token (no secret needed; set CRON_GITHUB_REPOSITORY=owner/repo if you fork). Other schedulers can send
# `Authorization: Bearer $CRON_SECRET` (>= 24 chars) instead.
# CRON_GITHUB_REPOSITORY=FriToS-Ban/Ledgerline
CRON_SECRET=
# Agent API (/api/v1): requests per minute per API key
API_RATE_LIMIT_PER_MIN=120
# Dev only: let webhooks target http:// and private addresses (ignored in production)
# WEBHOOK_ALLOW_PRIVATE=1
# Worker: poll interval in ms; set DISABLE_WORKER=1 to turn the background loop off
WORKER_INTERVAL_MS=15000
DISABLE_WORKER=0

# Sign-in (roles: clerk / approver / admin).
# AUTH_SECRET signs the Auth.js session JWTs. REQUIRED in production (>= 32 chars, e.g. `openssl rand -hex 32`).
# In development, leave it empty and a random secret is generated once into data/auth.secret (gitignored).
AUTH_SECRET=
AUTH_DISABLED=0
# Auth.js host trust: set AUTH_URL to the public origin (or AUTH_TRUST_HOST=1 behind a trusted proxy). Not needed in dev.
AUTH_URL=
# Production also requires AUTH_URL to be https:// (AUTH_ALLOW_HTTP=1 to override on a trusted network) and APP_ORIGINS or TRUST_PROXY=1.
AUTH_ALLOW_HTTP=0
S3_ALLOW_INSECURE=0
# Demo accounts (clerk@/approver@/admin@ledgerline.demo) exist and can sign in ONLY when DEMO_USERS=1,
# in every environment. For local dev put DEMO_USERS=1 in .env.local.
DEMO_USERS=0
# In production DEMO_USERS=1 requires a DEMO_PASSWORD of >= 12 chars that is not the default.
DEMO_PASSWORD=ledgerline
# Self sign-up creates a personal workspace and makes the user its owner (or joins one via an invite).
# Extra origins allowed to send mutating API requests (comma-separated, e.g. https://app.example.com).
# Matched on the full origin. The request's own Host is always allowed.
APP_ORIGINS=
# Set TRUST_PROXY=1 ONLY when a reverse proxy/CDN in front of the app sets X-Forwarded-For / X-Real-IP /
# X-Forwarded-Host / X-Forwarded-Proto. Then sign-in/sign-up are also rate-limited per client IP
# (the entry TRUSTED_PROXY_HOPS places from the right of X-Forwarded-For). Off => per-email limits only.
TRUST_PROXY=0
TRUSTED_PROXY_HOPS=1

# PostgreSQL (docker compose up -d db; POSTGRES_PASSWORD is REQUIRED by compose. "postgres" is fine for local dev, but
# production refuses postgres:postgres credentials, including in the containerized app). Migrate with `npm run db:migrate`, seed with `npm run db:seed`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledgerline
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline
# Used by `npm test`; a throwaway database per test file is created on this server.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline_test

# Object storage: any S3-compatible service (AWS S3, R2, MinIO). `docker compose --profile dev up -d s3` gives a
# dev-only S3-compatible mock (adobe/s3mock, 127.0.0.1:9090, bucket pre-created, no credential checks). Production refuses a
# plain http:// S3_ENDPOINT unless S3_ALLOW_INSECURE=1. In production S3_ENDPOINT may be
# blank for AWS S3 and S3_FORCE_PATH_STYLE should match your provider.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=ledgerline
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-secret
S3_FORCE_PATH_STYLE=1
# STORAGE_DRIVER=memory keeps files in process memory (tests only)
STORAGE_DRIVER=

# ERP connector (optional): GET this URL for { vendors, purchaseOrders, poLines }
ERP_URL=
ERP_TOKEN=
ERP_SYNC_MINUTES=15

# Dashboard assumption: minutes an AP clerk spends per invoice by hand
MANUAL_MINUTES_PER_INVOICE=6

# Which LLM writes the memo: nvidia | google | anthropic | openai (blank = first key found)
LLM_PROVIDER=
# Seconds-scale cap so a slow model can never stall the queue
LLM_TIMEOUT_MS=12000
# Cap for the model that reads a whole PDF (scanned pages / missing total or invoice number)
VISION_TIMEOUT_MS=30000
# Scanned PDF pages beyond this are not OCR'd; OCR model cache (default: OS temp dir)
MAX_OCR_PAGES=6
# TESSERACT_CACHE_DIR=
